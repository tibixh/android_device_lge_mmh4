cc_binary {
    name: "android.hardware.light@2.0-service.mmh4",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.light@2.0-service.mmh4.rc"],
    srcs: [
        "Light.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libhidlbase",
        "libhidltransport",
        "android.hardware.light@2.0",
    ],
}
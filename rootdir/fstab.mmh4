# TODO: add back encryption

# [ DEVICE_BLOCK ]                                               [ MOUNT_POINT ]          [TYPE] [MNT_FLAGS AND OPTIONS ]                                [ FS_MGR_FLAGS ]

# Android Native
/dev/block/platform/bootdevice/by-name/system                        /                     ext4 ro wait,slotselect,verify,recoveryonly
/dev/block/platform/bootdevice/by-name/vendor                        /vendor               ext4 ro wait,slotselect,verify,recoveryonly
/dev/block/platform/bootdevice/by-name/userdata                      /data                 ext4 noatime,nosuid,nodev,noauto_da_alloc,errors=panic         wait,check,formattable,resize,quota,reservedsize=128M
/dev/block/platform/bootdevice/by-name/protect1                      /mnt/vendor/protect_f     ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/protect2                      /mnt/vendor/protect_s     ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/nvdata                        /mnt/vendor/nvdata        ext4 noatime,nosuid,nodev,noauto_da_alloc,discard              wait,check,formattable
/dev/block/platform/bootdevice/by-name/nvcfg                         /mnt/vendor/nvcfg         ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/persist                       /mnt/vendor/persist   ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/frp                           /persistent           emmc defaults                                                  defaults

/devices/platform/externdevice* auto auto defaults voldmanaged=sdcard1:auto
/devices/platform/11200000.usb0/musb-hdrc/usb* auto auto defaults voldmanaged=usbotg:auto

# MTK Native
/dev/block/platform/bootdevice/by-name/nvram                         /nvram                emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/proinfo                       /proinfo              emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/lk                            /bootloader           emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/para                          /misc                 emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/boot                          /boot                 emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/logo                          /logo                 emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/expdb                         /expdb                emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/seccfg                        /seccfg               emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/tee                           /tee                  emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/scp                           /scp                  emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/sspm                          /sspm                 emmc defaults                                                  defaults,slotselect
/dev/block/platform/bootdevice/by-name/efuse                         /efuse                emmc defaults                                                  defaults
/dev/block/platform/bootdevice/by-name/spmfw                         /spmfw                emmc defaults                                                  defaults,slotselect

# LGE Added
/dev/block/platform/bootdevice/by-name/mpt                           /mnt/vendor/mpt           ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/carrier                       /mnt/product/carrier       ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/els                           /mnt/product/els           ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable
/dev/block/platform/bootdevice/by-name/oem                           /oem                  ext4 ro,noatime,nosuid,nodev,context=u:object_r:op_file:s0     wait,slotselect
/dev/block/platform/bootdevice/by-name/OP                            /oem/OP               ext4 ro,noatime,nosuid,nodev,context=u:object_r:op_file:s0     wait,slotselect
